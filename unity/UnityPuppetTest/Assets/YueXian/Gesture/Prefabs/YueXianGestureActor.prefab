    clip: {fileID: 8300000, guid: e1a01493668073445894b33acc29bd2c, type: 3}
    taiwanese: "\u4E00\u66F2\u884C\u6C5F\u6E56\uFF0C\u4ECA\u6697\u6703\u8457\u5C11\u4FE0\uFF0C\u6709\u79AE\u77E3\u3002"
    subtitle: "\u4E00\u66F2\u884C\u8D70\u6C5F\u6E56\uFF0C\u4ECA\u665A\u9047\u898B\u5C11\u4FE0\uFF0C\u6709\u79AE\u4E86\u3002"
  - sourceAction: LANDSCAPE
    actionId: MUSIC_PLAY_SLOW
    clip: {fileID: 8300000, guid: 4b477274530aa8a40ad3dfcc22be9ecd, type: 3}
    taiwanese: "\u6708\u8272\u906E\u723E\u597D\uFF0C\u4E14\u807D\u6211\u64A5\u5F26\u4E00\u66F2\u3002"
    subtitle: "\u5982\u6B64\u7F8E\u597D\u7684\u6708\u8272\uFF0C\u4E14\u807D\u6211\u5F48\u594F\u4E00\u66F2\u3002"
  - sourceAction: DRINK
    actionId: MUSIC_PAUSE
    clip: {fileID: 8300000, guid: 6d176fe3dfedc0c4b8bfe7bcc33ea741, type: 3}
    taiwanese: "\u54C8\u54C8\uFF01\u4F60\u98F2\u597D\u9152\uFF0C\u6211\u7528\u7434\u8072\u5171\u4F60\u9B25\u9B27\u71B1\uFF01"
    subtitle: "\u54C8\u54C8\uFF01\u4F60\u559D\u4F60\u7684\u597D\u9152\uFF0C\u6211\u7528\u7434\u8072\u966A\u4F60\u52A9\u8208\uFF01"
  - sourceAction: ALERT
    actionId: MUSIC_CHALLENGE
    clip: {fileID: 8300000, guid: 8e2b4004ed9db844986a6ed0f103843d, type: 3}
    taiwanese: "\u83AB\u6025\uFF01\u6211\u6B32\u770B\u4F60\u7684\u528D\uFF0C\u6562\u8FFD\u6703\u8457\u6211\u7684\u7434\u8072\uFF01"
    subtitle: "\u5225\u6025\uFF01\u6211\u53EA\u662F\u60F3\u770B\u770B\uFF0C\u4F60\u7684\u528D\u80FD\u4E0D\u80FD\u8FFD\u4E0A\u6211\u7684\u7434\u8072\uFF01"
  - sourceAction: ATTACK
    actionId: MUSIC_PLAY_FAST
    clip: {fileID: 8300000, guid: 00c3f3c14b456ac41a83b86cd289a165, type: 3}
    taiwanese: "\u597D\u528D\u6CD5\uFF01\u5F26\u8072\u50AC\u528D\uFF0C\u528D\u8D70\u89AA\u50CF\u98A8\uFF01"
    subtitle: "\u597D\u528D\u6CD5\uFF01\u7434\u5F26\u50AC\u52D5\u528D\u52E2\uFF0C\u528D\u8D70\u5982\u98A8\uFF01"
