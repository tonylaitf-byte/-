  idleClip: {fileID: 7400000, guid: 724d39b8f5702fb4ebc32a4e53eabb9a, type: 2}
  music: {fileID: 0}
  lines:
  - actionId: Bow
    displayName: "\u97A0\u8EAC"
    taiwanese: "\u6708\u4E0B\u76F8\u9022\u5C31\u662F\u7DE3\uFF0C\u670B\u53CB\uFF0C\u5E78\u6703\u77E3\uFF01"
    subtitle: "\u6708\u4E0B\u76F8\u9022\u4FBF\u662F\u6709\u7DE3\uFF0C\u670B\u53CB\uFF0C\u5E78\u6703\u4E86\uFF01"
    voice: {fileID: 8300000, guid: c90e111e23f47e74c8945581d74a592a, type: 3}
    animation: {fileID: 7400000, guid: d30061fa248892c4a927bd1418b86662, type: 2}
  - actionId: Landscape
    displayName: "\u8CDE\u6708"
    taiwanese: "\u4ECA\u669D\u6708\u5A18\u771F\u5AA0\uFF0C\u4E88\u4EBA\u770B\u7532\u8882\u653E\u3002"
    subtitle: "\u4ECA\u665A\u7684\u6708\u4EAE\u771F\u7F8E\uFF0C\u8B93\u4EBA\u6368\u4E0D\u5F97\u79FB\u958B\u76EE\u5149\u3002"
    voice: {fileID: 8300000, guid: 7d5e25c10f0d48f48956851fce56be6a, type: 3}
    animation: {fileID: 7400000, guid: 83044959665d6984aaeae6a9a1753126, type: 2}
  - actionId: Drink
    displayName: "\u559D\u9152"
    taiwanese: "\u6709\u597D\u6708\u3001\u6709\u597D\u7434\uFF0C\u54EA\u901A\u6703\u4F7F\u7121\u597D\u9152\uFF01"
    subtitle: "\u6709\u597D\u6708\u8272\u3001\u6709\u597D\u7434\u8072\uFF0C\u600E\u9EBC\u80FD\u6C92\u6709\u597D\u9152\uFF01"
    voice: {fileID: 8300000, guid: a0df403421571b6448b776c2a976b6a7, type: 3}
    animation: {fileID: 7400000, guid: a6a616fbed617964e9444a9d7e32376f, type: 2}
  - actionId: Alert
    displayName: "\u8B66\u60D5"
    taiwanese: "\u55EF\uFF1F\u4F60\u60F3\u6B32\u5275\u5565\u7269\uFF1F"
    subtitle: "\u55EF\uFF1F\u4F60\u60F3\u505A\u4EC0\u9EBC\uFF1F"
    voice: {fileID: 8300000, guid: 69c63e3300a39a34e83416f0df22a862, type: 3}
    animation: {fileID: 7400000, guid: a7ef9e35920ef954b9b5a649172b181f, type: 2}
  - actionId: Attack
