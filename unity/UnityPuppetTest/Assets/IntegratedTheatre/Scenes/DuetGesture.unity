    animation: {fileID: 7400000, guid: 83044959665d6984aaeae6a9a1753126, type: 2}
  - actionId: Drink
    displayName: "\u559D\u9152"
    taiwanese: "\u6709\u597D\u6708\u3001\u6709\u597D\u7434\uFF0C\u54EA\u901A\u6703\u4F7F\u7121\u597D\u9152\uFF01"
    subtitle: "\u6709\u597D\u6708\u8272\u3001\u6709\u597D\u7434\u8072\uFF0C\u600E\u9EBC\u80FD\u6C92\u6709\u597D\u9152\uFF01"
